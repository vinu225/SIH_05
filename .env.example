# ==============================================================================
# AICTE Scrutiny Platform Environment Variables (.env)
# ==============================================================================

# Backend Service Settings
HOST=0.0.0.0
PORT=8000
PYTHONPATH=/app

# Dataset Root Directory inside container
AICTE_DATASET_DIR=/app/data/synthetic_scenarios

# Host Port Mappings
HOST_BACKEND_PORT=8000
HOST_FRONTEND_PORT=3000

# ==============================================================================
# Supabase Cloud Database & Auth Configuration
# ==============================================================================
# Supabase Project API URL & Public Anon Key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Side Service Role Key (Keep secret, backend only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL Connection (Optional for ORM / direct pooling)
SUPABASE_DB_HOST=db.your-project-id.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-database-password

# Frontend Vite Client Credentials (if connecting directly from UI)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ==============================================================================
# Clerk Single Sign-On (SSO) & Authentication
# ==============================================================================
# Frontend Clerk Publishable Key (From Clerk Dashboard: https://dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Backend Clerk Secret Key (For server-side JWT session validation)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
