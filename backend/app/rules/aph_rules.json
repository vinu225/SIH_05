      "clause_reference": "Annexure 5, Section 5.2 (Cadre Distribution)",
      "handbook_page_no": 114,
      "title": "Cadre Ratio Compliance (1:2:6)",
      "description": "The faculty cadre distribution must strictly adhere to the ratio of 1 Professor : 2 Associate Professors : 6 Assistant Professors.",
      "applicability": {
        "program_category": "ALL",
        "level": "ALL"
      },
      "effective_from": "2024-04-01",
      "effective_until": null,
      "parameters": {
        "professor_proportion": 1,
        "associate_professor_proportion": 2,
        "assistant_professor_proportion": 6
      }
    },
